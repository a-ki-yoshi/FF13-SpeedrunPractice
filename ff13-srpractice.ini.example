[hotkeys]
global_hotkeys = 0
help           = F1
game_speed     = F2
kill_mode      = F3
warp           = F4
enemy_suppress = F5
save           = F7
camera_unstick = F8
save_tidy      = F9
battle_overlay = F10
battle_picker  = F11
picker_up      = Up
picker_down    = Down
picker_left    = Left
picker_right   = Right
cancel         = Backspace
menu_ok        = Enter
list_prev      = A
list_next      = D

[game_speed]
multiplier = 3.0

[battle_picker]
bgm_delay_ms = 1200

[save]
list_mark = *
save_dir =
keep_note = off

[overlay]
top_px = 34

[log]
level = normal
